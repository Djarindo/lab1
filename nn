#include <avr/io.h>
#define F_CPU 11059200UL
#include <util/delay.h>
#include <avr/interrupt.h>

// Точные битовые маски для знака «Внимание» (16 столбцов)
// Индексы 0..7 — левая половина матрицы, 8..15 — правая половина

// ВЕРХНЯЯ ЧАСТЬ МАТРИЦЫ (ряды 1-8 -> PORTA)
const uint8_t warn_top = {
    0x00, 0x00, 0x00, 0x00, 0x0F, 0x3F, 0xFC, 0xF0, // Левая верхняя ячейка
    0xF0, 0xFC, 0x3F, 0x0F, 0x00, 0x00, 0x00, 0x00  // Правая верхняя ячейка
};

// НИЖНЯЯ ЧАСТЬ МАТРИЦЫ (ряды 9-16 -> PORTC)
const uint8_t warn_bot = {
    0x00, 0x03, 0x0F, 0x3F, 0xFD, 0xFD, 0xFC, 0xFC, // Левая нижняя ячейка
    0xFC, 0xFC, 0xFD, 0xFD, 0x3F, 0x0F, 0x03, 0x00  // Правая нижняя ячейка
};

// Глобальные переменные без volatile
uint8_t collumne = 0;
uint8_t mask = 0x00; 
uint16_t timer = 0;

ISR(TIMER2_OVF_vect){ 
    TCNT2 = 83; // Частота ~1 мс из вашего рабочего кода
    
    // Переключение инверсии (мигания) каждые 500 мс
    timer++;
    if(timer >= 500){
        timer = 0;
        mask ^= 0xFF; 
    }
    
    // Гасим порты перед переключением столбца, чтобы не было паразитной засветки
    PORTA = 0x00;
    PORTC = 0x00;

    // Выставляем адрес столбца (PD4 переключает лево/право)
    PORTD = (collumne << 4);

    // Применяем маску инверсии к текущему столбцу
    uint8_t img_top = warn_top[collumne] ^ mask;
    uint8_t img_bot = warn_bot[collumne] ^ mask;

    // Распределяем данные по вашей аппаратной логике
    if(collumne < 8){
        PORTA = img_top; // Левый верх
        PORTC = img_bot; // Левый низ
    }
    else{
        PORTA = img_top; // Правый верх
        PORTC = img_bot; // Правый низ
    }

    // Цикл по всем 16 столбцам матрицы
    collumne++;
    if(collumne >= 16){
        collumne = 0;
    }
}

int main(void)
{
    // Настройка портов строго по вашему рабочему примеру
    DDRC = 0xFF;
    DDRA = 0xFF;
    DDRD = 0xF0;

    // Настройка таймера 2
    TCNT2 = 83;
    TCCR2 = (1 << CS21) | (1 << CS20);
    TIMSK = (1 << TOIE2);

    sei();

    while (1) 
    {
        // Всё крутится автоматически в прерывании
    }
}
