
#define F_CPU 11059200UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <stdint.h>
#include <stdlib.h>

// ---------------- НАСТРОЙКИ ----------------

#define BAUD 19200UL
#define UBRR_VALUE ((F_CPU / (16UL * BAUD)) - 1)

// PA1-PA5 выбирают разряды индикатора
#define DIGIT_MASK ((1 << PA1) | (1 << PA2) | (1 << PA3) | \
                    (1 << PA4) | (1 << PA5))

// Таблица символов для семисегментного индикатора
// 10 - пустой разряд, 11 - минус
const uint8_t symbols[12] = {
    0x3F, 0x06, 0x5B, 0x4F,
    0x66, 0x6D, 0x7D, 0x07,
    0x7F, 0x6F, 0x00, 0x40
};

// ---------------- ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ ----------------

// Счётчики времени
volatile uint16_t uart_ms_counter = 0;
volatile uint16_t progress_ms_counter = 0;
volatile uint32_t uart_seconds = 0;

// Флаги событий
volatile uint8_t reset_flag = 0;
volatile uint8_t second_flag = 0;
volatile uint8_t progress_flag = 0;

// Цифры для отображения на пяти индикаторах
// Порядок: PA1, PA2, PA3, PA4, PA5
// PA1 - старший разряд, PA5 - младший
volatile uint8_t display_digits[5] = {10, 10, 1, 0, 0};

volatile uint8_t scan_position = 0;

// Арифметическая прогрессия
uint16_t progression = 100;

// ---------------- UART ----------------

void uartInit(void)
{
    UBRR0H = (uint8_t)(UBRR_VALUE >> 8);
    UBRR0L = (uint8_t)UBRR_VALUE;

    UCSR0A = 0;
    UCSR0B = (1 << TXEN0);
    UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

void uartTransmitByte(uint8_t data)
{
    while (!(UCSR0A & (1 << UDRE0)))
    {
    }

    UDR0 = data;
}

void uartTransmitString(const char *str)
{
    while (*str)
    {
        uartTransmitByte(*str++);
    }
}

void uartTransmitNumber(uint32_t number)
{
    char buffer[11];

    ultoa(number, buffer, 10);
    uartTransmitString(buffer);
}

// ---------------- ИНДИКАТОРЫ ----------------

void sevensegment(void)
{
    DDRA |= DIGIT_MASK;
    DDRC = 0xFF;

    PORTA &= ~DIGIT_MASK;
    PORTC = 0;
}

// Подготавливает число для пяти индикаторов
void shownumber(uint16_t value)
{
    uint8_t digits[5];

    // Сначала заполняем все разряды нулями
    for (uint8_t i = 0; i < 5; i++)
    {
        digits[i] = 10;
    }

    // Записываем цифры справа налево
    for (int8_t i = 4; i >= 0; i--)
    {
        digits[i] = value % 10;
        value /= 10;

        if (value == 0)
        {
            break;
        }
    }

    // Обновляем массив атомарно
    uint8_t oldSREG = SREG;
    cli();

    for (uint8_t i = 0; i < 5; i++)
    {
        display_digits[i] = digits[i];
    }

    SREG = oldSREG;
}

// ---------------- TIMER2 ----------------

void timer2Init(void)
{
    // Отключаем асинхронный режим Timer2
    ASSR &= ~(1 << AS2);

    // Режим CTC
    TCCR2 = (1 << WGM21);

    // Частота таймера: F_CPU / 64
    // Период прерывания примерно 1 мс
    OCR2 = 172;

    // Сброс счётчика
    TCNT2 = 0;

    // Сброс флага сравнения
    TIFR = (1 << OCF2);

    // Разрешаем прерывание по совпадению
    TIMSK |= (1 << OCIE2);

    // Запуск Timer2 с делителем 64
    TCCR2 |= (1 << CS22);
}

// Прерывание Timer2 вызывается примерно каждую миллисекунду
ISR(TIMER2_COMP_vect)
{
    // -------- Обновление пяти индикаторов --------

    // Выключаем все разряды перед сменой сегментов
    PORTA &= ~DIGIT_MASK;

    // Выводим сегменты текущей цифры
    PORTC = symbols[display_digits[scan_position]];

    // Включаем нужный разряд
    PORTA |= (1 << (PA1 + scan_position));

    scan_position++;

    if (scan_position >= 5)
    {
        scan_position = 0;
    }

    // -------- Счётчик секунд для UART --------

    uart_ms_counter++;

    if (uart_ms_counter >= 1000)
    {
        uart_ms_counter = 0;
        uart_seconds++;
        second_flag = 1;
    }

    // -------- Отдельный таймер прогрессии --------

    progress_ms_counter++;

    if (progress_ms_counter >= 1000)
    {
        progress_ms_counter = 0;
        progress_flag = 1;
    }
}

// ---------------- КНОПКА INT0 ----------------

void buttonInit(void)
{
    // PD0 (INT0) - вход
    DDRD &= ~(1 << PD0);

    // Включаем внутреннюю подтяжку
    PORTD |= (1 << PD0);

    // INT0 срабатывает по спадающему фронту
    MCUCR |= (1 << ISC01);
    MCUCR &= ~(1 << ISC00);

    // Сбрасываем возможный старый флаг
    GIFR |= (1 << INTF0);

    // Разрешаем внешнее прерывание INT0
    GICR |= (1 << INT0);
}

ISR(INT0_vect)
{
    reset_flag = 1;
}

// ---------------- MAIN ----------------

int main(void)
{
    sevensegment();
    shownumber(progression);

    uartInit();
    buttonInit();
    timer2Init();

    // Глобальное разрешение прерываний
    sei();

    while (1)
    {
        uint8_t oldSREG;
        uint8_t local_reset;
        uint8_t local_second;
        uint8_t local_progress;
        uint32_t seconds_copy;

        // -------- Проверка кнопки --------

        oldSREG = SREG;
        cli();

        local_reset = reset_flag;
        reset_flag = 0;

        if (local_reset)
        {
            // Сбрасываем только UART-счётчик
            uart_seconds = 0;
            uart_ms_counter = 0;
            second_flag = 0;
        }

        SREG = oldSREG;

        if (local_reset)
        {
            // Сразу выводим ноль в UART
            uartTransmitNumber(0);
            uartTransmitString("\r\n");
        }

        // -------- Проверка секунды UART --------

        oldSREG = SREG;
        cli();

        local_second = second_flag;
        second_flag = 0;

        seconds_copy = uart_seconds;

        SREG = oldSREG;

        if (local_second)
        {
            uartTransmitNumber(seconds_copy);
            uartTransmitString("\r\n");
        }

        // -------- Обновление прогрессии --------

        oldSREG = SREG;
        cli();

        local_progress = progress_flag;
        progress_flag = 0;

        SREG = oldSREG;

        if (local_progress)
        {
            progression += 20;

            if (progression > 600)
            {
                progression = 100;
            }

            shownumber(progression);
        }
    }
}
