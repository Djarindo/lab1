#define F_CPU 11059200UL // Тактовая частота МК (если не задана в настройках AVR Helper)

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <stdio.h>

// Таблица кодов отображения цифр 0..9 на семисегментном индикаторе (общий катод через ULN2003)
const uint8_t segCodes[10] = {
    0x3F, // 0
    0x06, // 1
    0x5B, // 2
    0x4F, // 3
    0x66, // 4
    0x6D, // 5
    0x7D, // 6
    0x07, // 7
    0x7F, // 8
    0x6F  // 9
};

volatile uint16_t pressCntr = 0; // Счётчик нажатий кнопки
volatile uint8_t tmCntr = 0;     // Счётчик переполнений таймера для подавления дребезга

// Инициализация портов ввода-вывода
void portsInit(void) {
    // Порты для семисегментного индикатора (как в ЛР №1)
    DDRC = 0xFF;               // PORTC - выходы на входы D0..D7 защелок 74HC573
    DDRA |= 0x3E;              // PA1..PA5 - выходы стробов LE1..LE5
    PORTA &= ~0x3E;

    // Настройка вывода PD2 (INT2) на вход для кнопки
    DDRD &= ~(1 << PD2);
    PORTD &= ~(1 << PD2);      // Внешняя подтяжка / нормальный низкий уровень для срабатывания по фронту
}

// Выделение m-й цифры (1..5 слева направо) пятиразрядного числа d
uint8_t digit(uint16_t d, uint8_t m) {
    uint8_t i = 5, a = 0;
    while (i) {
        a = d % 10;
        if (i-- == m) break;
        d /= 10;
    }
    return a;
}

// Вывод пятиразрядного числа на семисегментные индикаторы без незначащих нулей слева
void displayNumber(uint16_t num) {
    uint8_t leadingZero = 1; // Флаг незначащих нулей слева

    for (uint8_t k = 1; k <= 5; k++) {
        uint8_t d = digit(num, k);

        if (d == 0 && leadingZero && k < 5) {
            PORTC = 0x00; // Гасим незначащий ноль
        } else {
            leadingZero = 0;
            PORTC = segCodes[d];
        }

        // Формирование строба 0-1-0 на линии PAk (k = 1..5)
        PORTA |= (1 << k);
        _delay_us(1);
        PORTA &= ~(1 << k);
    }
}

// Инициализация UART0: 19200 бод, 8 бит данных, 1 стоп-бит, без паритета
void uartInit(void) {
    UCSR0B |= (1 << TXEN0);                  // Включение передатчика
    UCSR0C |= (1 << UCSZ01) | (1 << UCSZ00); // Формат кадра 8 бит
    UBRR0H = 0;
    UBRR0L = 0x24;                           // 36 (0x24) для 19200 бод при 11.0592 МГц
}

// Передача одного байта по UART0
void uartTransmitByte(char byte) {
    while (!(UCSR0A & (1 << UDRE0)));        // Ожидание освобождения буфера передачи
    UDR0 = byte;
}

// Передача строки по UART0
void uartSendStr(char *str) {
    while (*str) {
        uartTransmitByte(*str++);
    }
}

// Настройка внешнего прерывания INT2 и Таймера 0
void interruptsInit(void) {
    // Настройка INT2 по нарастающему фронту (ISC21 = 1, ISC20 = 1 в регистре EICRA)
    EICRA |= (1 << ISC21) | (1 << ISC20);
    EIFR |= (1 << INTF2);   // Сброс флага внешнего прерывания INT2
    EIMSK |= (1 << INT2);   // Разрешение внешнего прерывания INT2

    // Настройка 8-битного Таймера 0 (Нормальный режим, предделитель 1024)
    // Частота тиков: 11059200 / 1024 = 10800 Гц. Одно переполнение (256 тиков) ~ 23.7 мс
    TCCR0 = (1 << CS02) | (1 << CS01) | (1 << CS00);
    TIMSK &= ~(1 << TOIE0); // Прерывание от Таймера 0 изначально запрещено
}

// Обработчик внешнего прерывания по нажатию кнопки (INT2)
ISR(INT2_vect) {
    EIMSK &= ~(1 << INT2);  // Запрещаем внешнее прерывание INT2 на время дребезга
    tmCntr = 0;             // Сбрасываем программный счётчик таймера
    TCNT0 = 0;              // Обнуляем счётный регистр Таймера 0
    TIFR |= (1 << TOV0);    // Сбрасываем флаг переполнения Таймера 0
    TIMSK |= (1 << TOIE0);  // Разрешаем прерывание по переполнению Таймера 0
}

// Обработчик прерывания по переполнению Таймера 0 (антидребезг ~23.7 мс)
ISR(TIMER0_OVF_vect) {
    TIMSK &= ~(1 << TOIE0); // Запрещаем прерывание от таймера

    // Проверяем состояние вывода PD2 (ожидаем высокий уровень после фронта)
    if (PIND & (1 << PD2)) {
        pressCntr++;        // Подтверждено нажатие -> увеличиваем счётчик
    }
EIFR |= (1 << INTF2);   // Очищаем возможный накопившийся флаг дребезга
    EIMSK |= (1 << INT2);   // Снова разрешаем внешнее прерывание INT2
}

int main(void) {
    char buffer[40];        // Буфер для формирования строки UART

    portsInit();
    uartInit();
    interruptsInit();
    sei();                  // Глобальное разрешение прерываний

    while (1) {
        // Цикл по варианту 8: от 200 до 800 с шагом 20
        for (uint16_t i = 200; i <= 800; i += 20) {
            displayNumber(i);
            _delay_ms(100);

            // Формируем и отправляем строку с текущим количеством нажатий
            snprintf(buffer, sizeof(buffer), "Button pressed %u times.\r\n", pressCntr);
            uartSendStr(buffer);
        }
    }
}
