#define F_CPU 11059200UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <stdio.h>

// Таблица кодов отображения цифр 0..9 на семисегментном индикаторе
const uint8_t segCodes[] = {
    0x3F, // 0
    0x06, // 1
    0x5B, // 2
    0x4F, // 3
    0x66, // 4
    0x6D, // 5
    0x7D, // 6
    0x07, // 7
    0x7F, // 8
    0x6F  // 9
};

volatile uint16_t pressCntr = 0; // Счётчик нажатий кнопки

// Инициализация портов ввода-вывода
void portsInit(void) {
    DDRC = 0xFF;               // PORTC - выходы на входы D0..D7 защелок 74HC573
    DDRA |= 0x3E;              // PA1..PA5 - выходы стробов LE1..LE5
    PORTA &= ~0x3E;

    DDRD &= ~(1 << PD2);       // PD2 (INT2) - вход кнопки
    PORTD &= ~(1 << PD2);
}

// Выделение m-й цифры (1..5 слева направо) пятиразрядного числа d
uint8_t digit(uint16_t d, uint8_t m) {
    uint8_t i = 5, a = 0;
    while (i) {
        a = d % 10;
        if (i-- == m) break;
        d /= 10;
    }
    return a;
}

// Вывод пятиразрядного числа на семисегментные индикаторы без незначащих нулей слева
void displayNumber(uint16_t num) {
    uint8_t leadingZero = 1;

    for (uint8_t k = 1; k <= 5; k++) {
        uint8_t d = digit(num, k);

        if (d == 0 && leadingZero && k < 5) {
            PORTC = 0x00;
        } else {
            leadingZero = 0;
            PORTC = segCodes[d];
        }

        // Строб 0-1-0 на линии PAk (k = 1..5)
        PORTA |= (1 << k);
        _delay_us(1);
        PORTA &= ~(1 << k);
    }
}

// Инициализация UART0: 19200 бод, 8N1
void uartInit(void) {
    UCSR0B |= (1 << TXEN0);                  // Включение передатчика
    UCSR0C |= (1 << UCSZ01) | (1 << UCSZ00); // 8 бит данных
    UBRR0H = 0;
    UBRR0L = 0x24;                           // 19200 бод при 11.0592 МГц
}

// Передача одного байта по UART0
void uartTransmitByte(char byte) {
    while (!(UCSR0A & (1 << UDRE0)));
    UDR0 = byte;
}

// Передача строки по UART0
void uartSendStr(char *str) {
    while (*str) {
        uartTransmitByte(*str++);
    }
}

// Настройка внешнего прерывания INT2 и Таймера 0
void interruptsInit(void) {
    // INT2 по нарастающему фронту (ISC21 = 1, ISC20 = 1)
    EICRA |= (1 << ISC21) | (1 << ISC20);
    EIFR |= (1 << INTF2);
    EIMSK |= (1 << INT2);

    // Таймер 0: нормальный режим, предделитель 1024 (~23.7 мс до переполнения)
    TCCR0 = (1 << CS02) | (1 << CS01) | (1 << CS00);
    TIMSK &= ~(1 << TOIE0);
}

// Прерывание по нажатию кнопки (INT2)
ISR(INT2_vect) {
    EIMSK &= ~(1 << INT2);  // Отключаем INT2 на время дребезга
    TCNT0 = 0;              // Сбрасываем таймер
    TIFR |= (1 << TOV0);    // Очищаем флаг переполнения
    TIMSK |= (1 << TOIE0);  // Запускаем ожидание переполнения Таймера 0
}

// Прерывание по переполнению Таймера 0 (подавление дребезга)
ISR(TIMER0_OVF_vect) {
    TIMSK &= ~(1 << TOIE0); // Останавливаем прерывания таймера

    // Если кнопка всё ещё нажата (высокий уровень на PD2)
    if (PIND & (1 << PD2)) {
        pressCntr++;
    }

    EIFR |= (1 << INTF2);   // Сбрасываем возможный флаг дребезга
    EIMSK |= (1 << INT2);   // Снова разрешаем INT2
}

int main(void) {
    char buffer[32];
    uint16_t lastPressCntr = 0;
    uint16_t currentPressCntr = 0;

    portsInit();
    uartInit();
    interruptsInit();
    sei();

    while (1) {
        // Цикл индикации для варианта 8: 200..800 с шагом 20 и паузой 100 мс
        for (uint16_t i = 200; i <= 800; i += 20) {
            displayNumber(i);
            _delay_ms(100);

            // Атомарно считываем текущее значение счётчика нажатий
            cli();
            currentPressCntr = pressCntr;
            sei();

            // Отправляем строку в терминал только при новом нажатии кнопки
            if (currentPressCntr != lastPressCntr) {
                lastPressCntr = currentPressCntr;
                snprintf(buffer, sizeof(buffer), "Button pressed %u times.\r\n", currentPressCntr);
                uartSendStr(buffer);
            }
        }
    }
}
