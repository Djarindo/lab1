#include <avr/io.h>
#define F_CPU 11059200UL
#include <util/delay.h>
#include <avr/interrupt.h>

uint8_t plane[16] = {0x10, 0x98, 0x58, 0xFF, 0xFF, 0x58, 0x98, 0x10,
	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
	
volatile uint8_t collumne = 0;
volatile uint8_t mask = 0xFF;
volatile uint16_t timer = 0;

ISR(TIMER2_OVF_vect){ // once in 1 ms
	TCNT2 = 83; //start position for counter
	timer++;
	if(timer >= 3000){
		timer = 0;
		mask ^= 0xFF;
	}
	PORTA = 0x00;
	PORTC = 0x00;
	
	PORTD = (collumne << 4);
	uint8_t img = plane[collumne] ^ mask;
	if(collumne < 8){
		PORTA = img;
	}
	else{
		PORTC = img;
	}
	
	collumne++;
	if(collumne >= 16){
		collumne = 0;
	}
}
