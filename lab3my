#define F_CPU 11059200UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <stdio.h>

// Параметры варианта 7 (диапазон 100...700, шаг 10)
#define START_VAL 100
#define END_VAL   700
#define STEP_VAL  10
#define CLEAR_SEG 10

// Таблица кодов для семисегментного индикатора (0..9, пусто, минус)
const uint8_t symbols[12] = {
    0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F, 0x00, 0x40
};

// Глобальные переменные для обмена с обработчиками прерываний
volatile uint16_t btn_count = 0;      // Счётчик нажатий кнопки
volatile uint8_t uart_send_flag = 1;  // Флаг необходимости отправки строки по UART

// --- Функции из ЛР №1 для семисегментного индикатора ---

uint8_t digit(uint16_t d, uint8_t m) {
    uint8_t i = 5, a = 0;
    while (i) {
        a = d % 10;
        if (i-- == m) break;
        d /= 10;
    }
    return a;
}

void sevensegment(void) {
    // Настройка линий защёлок LE1..LE5 (PA1..PA5) на выход
    DDRA |= (1 << 1) | (1 << 2) | (1 << 3) | (1 << 4) | (1 << 5);
    // Настройка порта сегментов PORTC на выход
    DDRC = 0xFF;
}

void shownumber(int32_t value) {
    if (value == 0) {
        PORTA |= (1 << 5);
        PORTC = 0x3F;
        PORTA &= ~(1 << 5);
    } else {
        uint8_t negative = 0;
        if (value < 0) {
            negative = 1;
            value *= (-1);
        }

        // Поиск первого значащего разряда
        uint8_t j = 0;
        while (digit(value, ++j) == 0);

        // Гашение незначащих нулей слева
        for (uint8_t i = 1; i < j; i++) {
            PORTA |= (1 << i);
            _delay_us(2);
            PORTC = symbols[CLEAR_SEG];
            PORTA &= ~(1 << i);
        }

        // Вывод значащих цифр
        for (uint8_t i = j; i <= 5; i++) {
            PORTA |= (1 << i);
            _delay_us(2);
            PORTC = symbols[digit(value, i)];
            PORTA &= ~(1 << i);
        }

        // Вывод знака минус при необходимости
        if (negative == 1) {
            PORTA |= (1 << 1);
            PORTC = symbols[11];
            PORTA &= ~(1 << 1);
        } else {
            PORTA |= (1 << 1);
            PORTC = 0;
            PORTA &= ~(1 << 1);
        }
    }
}

// --- Функции для работы с UART0 ---

void uartInit(void) {
    // Включение передатчика UART0
    UCSR0B |= (1 << TXEN0);
    // Формат кадра: 8 бит данных, 1 стоп-бит, без паритета
    UCSR0C |= (1 << UCSZ01) | (1 << UCSZ00);
    // Скорость 19200 бод при F_CPU = 11.0592 МГц (UBRR0 = 35 = 0x23)
    UBRR0H = 0;
    UBRR0L = 0x23;
}

void uartTransmitByte(char byte) {
    // Ожидание освобождения буфера передачи
    while (!(UCSR0A & (1 << UDRE0)));
    UDR0 = byte;
}

void uartTransmitString(const char *str) {
    while (*str) {
        uartTransmitByte(*str++);
    }
}

// --- Инициализация внешнего прерывания INT2 и Таймера 0 ---

void extInt2Init(void) {
    // Ножка PD2 (INT2) на вход
    DDRD &= ~(1 << PD2);

    // Вариант 7: прерывание по нарастающему фронту (ISC21 = 1, ISC20 = 1)
    EICRA |= (1 << ISC21) | (1 << ISC20);

    // Сброс флага прерывания перед разрешением
    EIFR |= (1 << INTF2);
    // Разрешение внешнего прерывания INT2
    EIMSK |= (1 << INT2);
}

void timer0DebounceInit(void) {
    // Режим CTC (сброс при совпадении с OCR0): WGM01 = 1, WGM00 = 0
    // Таймер пока остановлен (CS02..00 = 0)
    TCCR0 = (1 << WGM01);
    // При предделителе 1024 частота счёта = 11059200 / 1024 = 10800 Гц
    // 200 тиков дают задержку ~18.5 мс для подавления дребезга
    OCR0 = 200;
}

// --- Обработчики прерываний ---

// 1. Срабатывание кнопки на INT2 (начало фронта)
ISR(INT2_vect) {
    // Запрещаем внешние прерывания на INT2 на время дребезга
    EIMSK &= ~(1 << INT2);

    // Сбрасываем счётчик таймера 0 и флаг совпадения
    TCNT0 = 0;
    TIFR |= (1 << OCF0);

    // Разрешаем прерывание по совпадению Таймера 0 и запускаем его (делитель 1024)
    TIMSK |= (1 << OCIE0);
    TCCR0 = (1 << WGM01) | (1 << CS02) | (1 << CS01) | (1 << CS00);
}

// 2. Окончание задержки антидребезга (~18.5 мс)
ISR(TIMER0_COMP_vect) {
    // Останавливаем Таймер 0 и запрещаем его прерывания
    TCCR0 = 0;
    TIMSK &= ~(1 << OCIE0);

    // Проверяем, действительно ли кнопка нажата (высокий уровень на PD2 при фронте)
    if (PIND & (1 << PD2)) {
        btn_count++;
        uart_send_flag = 1;
    }

    // Сбрасываем накопившийся за время дребезга флаг INTF2 и снова разрешаем INT2
    EIFR |= (1 << INTF2);
    EIMSK |= (1 << INT2);
}

// --- Главная функция ---

int main(void) {
    char msg_buffer[32];

    sevensegment();
    uartInit();
    timer0DebounceInit();
    extInt2Init();

    // Глобальное разрешение прерываний
    sei();

    while (1) {
        for (int32_t val = START_VAL; val <= END_VAL; val += STEP_VAL) {
            // Вывод текущего числа прогрессии на индикатор
            shownumber(val);

            // Если произошло подтверждённое нажатие кнопки — отправляем строку в UART
            if (uart_send_flag) {
                uart_send_flag = 0;
                snprintf(msg_buffer, sizeof(msg_buffer), "Button pressed %u times.\r\n", btn_count);
                uartTransmitString(msg_buffer);
            }

            // Пауза 100 мс между числами по условию задания
            _delay_ms(100);
        }
    }
}
