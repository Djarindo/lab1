#include <avr/io.h>
#define F_CPU 11059200UL
#include <util/delay.h>
#include <avr/interrupt.h>

// left side of matrix
const uint8_t imgL[16] = {
	0xFF, 0xFF, 0xC0, 0xC0, 0xC0, 0xC0, 0xC0, 0xFF,
	0x03, 0x03, 0x03, 0xFF, 0xFF, 0x03, 0x03, 0x03

};

// right side of matrix
const uint8_t imgR[16] = {
	0xFF, 0xC0, 0xC0, 0xC0, 0xC0, 0xC0, 0xFF, 0xFF,
	0x03, 0x03, 0x03, 0xFF, 0xFF, 0x03, 0x03, 0x03
};

// global
uint8_t collumne = 0;
uint8_t mask = 0x00;
uint16_t timer = 0;

// timer by overflow
ISR(TIMER2_OVF_vect){
	TCNT2 = 83; // new start position
	
	timer++;

	// time to change the mask
	if(timer >= 500){
		timer = 0;
		mask ^= 0xFF;
	}
	
	// lights off
	PORTA = 0x00;
	PORTC = 0x00;

	// redirect half
	PORTD = (collumne << 4);

	uint8_t img_L = imgL[collumne] ^ mask;
	uint8_t img_R = imgR[collumne] ^ mask;

	if(collumne < 8){
		PORTA = img_L;
		PORTC = img_R;
	}
	else{
		PORTA = img_L;
		PORTC = img_R;
	}

	collumne++;
	if(collumne >= 16){
		collumne = 0;
	}
}


