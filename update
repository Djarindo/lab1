#include <avr/io.h>
#define F_CPU 11059200UL
#include <util/delay.h>
#include <avr/interrupt.h>

#define STATE_PLANE 0
#define STATE_WARN  1

// Теперь массивы разделены: 
// [кадр][столбец]. Столбцов всего 8, так как левая и правая половины горят одновременно!

// --- САМОЛЕТ (Вид сбоку, 3 кадра анимации) ---
// Левая половина самолета (столбцы 1-8 -> PORTA)
const uint8_t plane_left[3][8] = {
    {0x00, 0x00, 0x18, 0x3C, 0x7E, 0xFF, 0xFF, 0xFF}, // Кадр 0
    {0x00, 0x10, 0x38, 0x7C, 0xFE, 0xFF, 0xFF, 0xFF}, // Кадр 1 (вверх)
    {0x00, 0x00, 0x0C, 0x1E, 0x3F, 0x7F, 0xFF, 0xFF}  // Кадр 2 (вниз)
};
// Правая половина самолета (столбцы 9-16 -> PORTC)
const uint8_t plane_right[3][8] = {
    {0xFF, 0xFF, 0xFF, 0x7E, 0x3C, 0x18, 0x00, 0x00}, // Кадр 0
    {0xFF, 0xFF, 0xFF, 0xFE, 0x7C, 0x38, 0x10, 0x00}, // Кадр 1 (вверх)
    {0xFF, 0xFF, 0x7F, 0x3F, 0x1E, 0x0C, 0x00, 0x00}  // Кадр 2 (вниз)
};

// --- ЗНАК ВНИМАНИЕ ---
// Левая половина знака (PORTA)
const uint8_t warn_left[8] = {0x01, 0x03, 0x07, 0x0F, 0x1F, 0x3F, 0x7F, 0xFF};
// Правая половина знака (PORTC)
const uint8_t warn_right[8] = {0xFF, 0x7F, 0x3F, 0x1F, 0x0F, 0x07, 0x03, 0x01};


// Глобальные переменные БЕЗ volatile
uint8_t collumne = 0;
uint8_t current_state = STATE_PLANE;
uint8_t plane_frame = 0;
int8_t anim_direction = 1;
uint16_t state_timer = 0;

// Единственный volatile флаг для связи ISR -> main
volatile uint8_t tick_flag = 0; 

ISR(TIMER2_OVF_vect){
    TCNT2 = 76; 
    
    // Гасим порты перед переключением (борьба с засветами)
    PORTA = 0x00;
    PORTC = 0x00;
    
    // Подаем адрес шага дешифратора на старшие 4 бита PORTD (от 0 до 7)
    PORTD = (collumne << 4);
    
    // Переменные для текущих половинок столбца
    uint8_t img_left = 0;
    uint8_t img_right = 0;
    
    // Выбираем данные в зависимости от текущего состояния экрана
    if (current_state == STATE_PLANE) {
        img_left  = plane_left[plane_frame][collumne];
        img_right = plane_right[plane_frame][collumne];
    } else {
        img_left  = warn_left[collumne];
        img_right = warn_right[collumne];
    }
    
    // Выводим: левый столбец в PORTA, правый — в PORTC
    PORTA = img_left;
    PORTC = img_right;
    
    // Вся матрица отрисовывается за 8 шагов (0-7)
    collumne++;
    if(collumne >= 8){
        collumne = 0;
    }
    
    // Внутренний таймер для тиков (~200 мс)
    static uint8_t ms_counter = 0;
    ms_counter++;
    if (ms_counter >= 200) {
        ms_counter = 0;
        tick_flag = 1; 
    }
}

int main(void)
{
    // Инициализация портов
    DDRC = 0xFF; 
    DDRA = 0xFF; 
    DDRD = 0xFF;
    
    PORTC = 0x00; 
    PORTD = 0x00; 
    PORTA = 0x00;
    
    // Настройка таймера 2 на переполнение
    TCNT2 = 76;
    TCCR2 = (1 << CS22); 
    TIMSK = (1 << TOIE2);
    
    sei();

    while (1) 
    {
        if (tick_flag) {
            tick_flag = 0; // Сброс флага прерывания
            
            // 1. Анимация полета самолета (изменение кадров 0 -> 1 -> 2 -> 1 -> 0...)
            if (current_state == STATE_PLANE) {
                plane_frame += anim_direction;
                if (plane_frame >= 2) {
                    anim_direction = -1;
                } else if (plane_frame <= 0) {
                    anim_direction = 1;
                }
            }
            
            // 2. Логика смены экранов (каждые 5 секунд)
            state_timer++;
            if (state_timer >= 25) { // 25 тиков по 200 мс = 5000 мс
                state_timer = 0;
                if (current_state == STATE_PLANE) {
                    current_state = STATE_WARN;
                } else {
                    current_state = STATE_PLANE;
                    plane_frame = 0;
                    anim_direction = 1;
                }
            }
        }
    }
}
