	timer++;
	if(timer >= 3000){
		timer = 0;
		mask ^= 0xFF;
	}
	PORTA = 0x00;
	PORTC = 0x00;
	
	PORTD = (collumne << 4);
	uint8_t img = plane[collumne] ^ mask;
	if(collumne < 8){
		PORTA = img;
	}
	else{
		PORTC = img;
	}
	
	collumne++;
	if(collumne >= 16){
		collumne = 0;
	}
}
