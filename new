// Массивы большого знака опасности (16 столбцов)
// _top уходит на PORTA (верх матрицы), _bot уходит на PORTC (низ матрицы)
const uint8_t warn_top[16] = {0x00, 0x01, 0x03, 0x07, 0x0F, 0x1F, 0x3F, 0x7F, 0x7F, 0x3F, 0x1F, 0x0F, 0x07, 0x03, 0x01, 0x00};
const uint8_t warn_bot[16] = {0x00, 0x80, 0xC0, 0xE0, 0xF0, 0xFA, 0xFA, 0xFA, 0xFA, 0xFA, 0xFA, 0xF0, 0xE0, 0xC0, 0x80, 0x00};

// Глобальные переменные БЕЗ volatile (используются теперь только внутри ISR)
uint8_t collumne = 0;
uint8_t mask = 0x00; // Начинаем с прямой картинки (для инверсии маска станет 0xFF)
uint16_t timer = 0;

ISR(TIMER2_OVF_vect){ // Срабатывает раз в ~1 мс согласно вашим настройкам
    TCNT2 = 83; // Стартовая позиция счетчика
    
    // Логика инверсии: каждые 500 мс переключаем маску
    timer++;
    if(timer >= 500){
        timer = 0;
        mask ^= 0xFF; // Инвертирует все биты (0x00 <-> 0xFF)
    }
    
    // Гасим порты перед переключением столбца для четкой картинки без шлейфов
    PORTA = 0x00;
    PORTC = 0x00;

    // Выставляем адрес столбца (PD4 переключает левую/правую ячейки матрицы)
    PORTD = (collumne << 4);

    // Берем данные знака и применяем маску инверсии
    uint8_t img_top = warn_top[collumne] ^ mask;
    uint8_t img_bot = warn_bot[collumne] ^ mask;

    // Выводим данные одновременно на верхнюю и нижнюю половины
    PORTA = img_top;
    PORTC = img_bot;

    // Сдвиг по всей ширине (16 столбцов)
    collumne++;
    if(collumne >= 16){
        collumne = 0;
    }
}

