#include <avr/io.h>
#define F_CPU 11059200UL
#include <util/delay.h>
#include <avr/interrupt.h>

// Массивы знака "Внимание", разделенные на Верх и Низ для всех 16 столбцов.
// Индексы 0..7 — это левая половина матрицы, индексы 8..15 — правая половина.
const uint8_t warn_top[16] = {
    0x00, 0x01, 0x03, 0x07, 0x0F, 0x1F, 0x3F, 0x7F, // Левая верхняя ячейка (PORTA, col 0-7)
    0x7F, 0x3F, 0x1F, 0x0F, 0x07, 0x03, 0x01, 0x00  // Правая верхняя ячейка (PORTA, col 8-15)
};

const uint8_t warn_bot[16] = {
    0x00, 0x80, 0xC0, 0xE0, 0xF0, 0xFA, 0xFA, 0xFA, // Левая нижняя ячейка (PORTC, col 0-7)
    0xFA, 0xFA, 0xFA, 0xF0, 0xE0, 0xC0, 0x80, 0x00  // Правая нижняя ячейка (PORTC, col 8-15)
};

// Глобальные переменные без volatile (используются только внутри прерывания)
uint8_t collumne = 0;
uint8_t mask = 0x00; 
uint16_t timer = 0;

ISR(TIMER2_OVF_vect){ 
    TCNT2 = 83; // Частота ~1 мс из вашего рабочего кода
    
    // Переключение инверсии каждые 500 мс
    timer++;
    if(timer >= 500){
        timer = 0;
        mask ^= 0xFF; 
    }
    
    // Гасим порты для предотвращения засветов
    PORTA = 0x00;
    PORTC = 0x00;

    // Выставляем адрес столбца. 
    // Младшие 3 бита управляют шагом дешифратора (0-7), 4-й бит (PD4) переключает лево/право
    PORTD = (collumne << 4);

    // Извлекаем данные для текущего столбца с применением маски инверсии
    uint8_t img_top = warn_top[collumne] ^ mask;
    uint8_t img_bot = warn_bot[collumne] ^ mask;

    // Распределяем данные согласно вашей аппаратной логике:
    // Мы ВСЕГДА отправляем верхнюю часть в PORTA, а нижнюю в PORTC.
    // А за то, куда они попадут (налево или направо), отвечает бит PD4 в PORTD.
    if(collumne < 8){
        PORTA = img_top; // Работает левая верхняя ячейка
        PORTC = img_bot; // Работает левая нижняя ячейка
    }
    else{
        PORTA = img_top; // Работает правая верхняя ячейка
        PORTC = img_bot; // Работает правая нижняя ячейка
    }

    // Полный цикл по всем 16 столбцам
    collumne++;
    if(collumne >= 16){
        collumne = 0;
    }
}

int main(void)
{
    // Настройка конфигурации портов (согласно вашему рабочему коду)
    DDRC = 0xFF;
    DDRA = 0xFF;
    DDRD = 0xF0;

    // Настройка таймера
    TCNT2 = 83;
    TCCR2 = (1 << CS21) | (1 << CS20);
    TIMSK = (1 << TOIE2);

    sei();

    while (1) 
    {
        // Цикл пустой, всё работает автономно в прерывании
    }
}
